{
  "name": "canvas-rce-api",
  "version": "1.27.6",
  "description": "An API for proxying requests by the RCE to Canvas and other services.",
  "engines": {
    "node": "^20",
    "npm": "^9"
  },
  "type": "module",
  "mocha": {
    "exit": true,
    "node-option": [
      "import=./instrument.js",
      "import=./test/support/setup.js"
    ]
  },
  "c8": {
    "include": [
      "app/**/*.js",
      "shared/**/*.js"
    ],
    "reporter": [
      "html"
    ]
  },
  "main": "app.js",
  "config": {
    "mocha_env": "test"
  },
  "scripts": {
    "lint": "eslint \"app/**/*.js\" \"test/**/*.js\" \"shared/**/*.js\"",
    "test": "mocha 'test/{service,shared}/**/*.test.js'",
    "test:one": "mocha",
    "test-cov": "cross-env BABEL_ENV=test c8 mocha 'test/{service,shared}/**/*.test.js'",
    "debug-test": "mocha --inspect-brk 'test/{service,shared}/**/*.test.js'",
    "debug-test:one": "mocha --inspect-brk",
    "fmt:check": "prettier -l '**/*.{js,json}'",
    "fmt:fix": "prettier --write '**/*.{js,json}'",
    "precommit": "pretty-quick --staged",
    "start": "node --import ./instrument.js app.js",
    "start:dev": "nodemon --watch app --watch config --exec 'node --import ./instrument.js' app.js",
    "start:debug": "node --inspect-brk --import ./instrument.js app.js",
    "security:dependency-monitor": "snyk monitor"
  },
  "author": "Instructure, Inc.",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.53.1",
    "cors": "^2.8.5",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "hot-shots": "14.3.1",
    "inja": "^1.1.0",
    "jose": "^6.2.3",
    "moment": "^2.22.2",
    "morgan": "^1.10.0",
    "parse-link-header": "^2.0.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "cross-env": "10.1.0",
    "dev-null": "0.1.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mocha": "11.3.0",
    "eslint-plugin-security": "4.0.0",
    "husky": "9.1.7",
    "mocha": "11.7.5",
    "nock": "14.0.15",
    "nodemon": "3.1.14",
    "prettier": "3.8.3",
    "pretty-quick": "4.2.2",
    "sinon": "22.0.0",
    "snyk": "1.1305.0",
    "supertest": "7.2.2"
  },
  "overrides": {
    "minimatch": "^10.2.3"
  }
}
