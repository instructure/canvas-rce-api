{
  "name": "canvas-rce-api",
  "version": "1.27.6",
  "description": "An API for proxying requests by the RCE to Canvas and other services.",
  "engines": {
    "node": "^20",
    "npm": "^9"
  },
  "mocha": {
    "exit": true,
    "require": [
      "dotenv/config",
      "test/support/setup"
    ]
  },
  "nyc": {
    "include": [
      "app/**/*.js",
      "shared/**/*.js"
    ]
  },
  "main": "app.js",
  "config": {
    "mocha_env": "test"
  },
  "scripts": {
    "lint": "eslint \"app/**/*.js\" \"test/**/*.js\" \"shared/**/*.js\"",
    "test": "mocha 'test/{service,shared}/**/*.test.js'",
    "test:one": "mocha",
    "test-cov": "cross-env BABEL_ENV=test nyc -r html node_modules/.bin/mocha -- 'test/{service,shared}/**/*.test.js'",
    "debug-test": "mocha --inspect-brk 'test/{service,shared}/**/*.test.js'",
    "debug-test:one": "mocha --inspect-brk",
    "fmt:check": "prettier -l '**/*.{js,json}'",
    "fmt:fix": "prettier --write '**/*.{js,json}'",
    "precommit": "pretty-quick --staged",
    "start": "node app.js",
    "start:dev": "nodemon --watch app --watch config app.js",
    "start:debug": "node --inspect-brk app.js",
    "security:dependency-monitor": "snyk monitor"
  },
  "author": "Instructure, Inc.",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^5.0.1",
    "escape-html": "^1.0.3",
    "express": "^4.20.0",
    "express-request-id": "^1.4.1",
    "hot-shots": "^6.1.1",
    "inja": "^1.1.0",
    "jsonwebtoken": "^5.7.0",
    "moment": "^2.22.2",
    "morgan": "^1.10.0",
    "node-exceptions": "^3.0.0",
    "node-fetch": "^2.6.1",
    "node-jose": "^2.0.0",
    "parse-link-header": "^2.0.0",
    "raven": "github:zwily/raven-node#middleware-req-callback"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "dev-null": "0.1.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-mocha": "11.3.0",
    "eslint-plugin-security": "4.0.0",
    "get-port": "7.2.0",
    "husky": "9.1.7",
    "mocha": "11.7.5",
    "nock": "^13",
    "nodemon": "3.1.14",
    "nyc": "18.0.0",
    "prettier": "3.8.3",
    "pretty-quick": "4.2.2",
    "sinon": "22.0.0",
    "snyk": "1.1305.0",
    "supertest": "7.2.2"
  },
  "overrides": {
    "minimatch": "^10.2.3",
    "qs": "^6.14.1",
    "jws": "^3.2.3",
    "node-forge": "^1.4.0"
  }
}
